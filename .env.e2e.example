# Biến môi trường cho E2E Playwright (xem playwright.config.ts và e2e/helpers/auth.ts).
# Playwright KHÔNG tự đọc file này: export biến ra shell, hoặc nạp file khi chạy, ví dụ:
#   cp .env.e2e.example .env.e2e.local   # .env.*.local đã nằm trong .gitignore
#   set -a; . ./.env.e2e.local; set +a; npm run test:e2e

# Địa chỉ frontend (Vite dev server). Mặc định: http://localhost:5173
E2E_BASE_URL=http://localhost:5173

# Địa chỉ API backend, gồm cả /api/v1. Mặc định: http://localhost:8080/api/v1
E2E_API_URL=http://localhost:8080/api/v1

# Hash secret VNPay để e2e/helpers/ipn.ts ký IPN giả lập. PHẢI trùng VNPAY_HASH_SECRET
# (VnPay__HashSecret) của backend đang chạy E2E; dùng secret sandbox/giả, đừng dùng secret thật.
E2E_VNPAY_HASH_SECRET=
# Tùy chọn: vnp_TmnCode trong IPN giả lập (backend không kiểm tra giá trị này).
# E2E_VNPAY_TMN_CODE=

# ---------------------------------------------------------------------------
# Cấu hình BACKEND khi chạy E2E (đặt ở .env/môi trường của backend, không phải của Playwright)
# ---------------------------------------------------------------------------

# 1) DB riêng: KHÔNG trỏ vào DB dev/production (Neon dùng chung). Test đăng nhập, đặt vé, quầy...
#    sẽ ghi dữ liệu thật. Tạo một database/branch riêng cho E2E, ví dụ:
#      DATABASE_URL=postgresql://user:password@host/perfo_e2e?sslmode=require
#      DATABASE_URL_DIRECT=postgresql://user:password@host/perfo_e2e?sslmode=require
#    Rồi `npm run db:update` để migrate + backend tự seed tài khoản mẫu
#    (admin@cinema.local, customer@cinema.local, employee@cinema.local).

# 2) Nâng rate limit: mặc định endpoint auth chỉ cho 5 lần / 60 giây theo IP (login, admin-login,
#    refresh dùng chung), và global là 100 lần / 60 giây. Chạy nhiều test/worker sẽ dính 429.
#    Lưu ý: docker-compose.yml hiện chỉ ánh xạ RATE_LIMIT_GLOBAL_SEGMENTS_PER_WINDOW và các biến
#    EXPORT/IMPORT; chưa có RATE_LIMIT_AUTH_* hay RATE_LIMIT_GLOBAL_PERMIT_LIMIT. Khi chạy backend
#    trực tiếp (npm run dev:backend) dùng tên biến cấu hình .NET:
#      RateLimit__AuthPermitLimit=1000
#      RateLimit__GlobalPermitLimit=10000
#      RateLimit__BookingHoldPermitLimit=1000
#    Nếu chạy bằng Docker, cần thêm các dòng tương ứng vào docker-compose.yml (chưa làm ở đây).

# 3) Mock hoàn tiền VNPay và outbox email cho e2e/booking-cancel-refund.spec.ts: spec tự dựng một HTTP server
#    giả lập (cổng E2E_MOCK_GATEWAY_PORT, mặc định 9099) thay cho API hoàn tiền VNPay và API Resend.
#    Backend PHẢI trỏ vào đó (nếu không thì hoàn tiền gọi sandbox thật và không có email nào vào outbox):
#      VnPay__ApiUrl=http://localhost:9099/transaction
#      Email__ResendApiKey=e2e-fake-key
#      Email__ResendApiUrl=http://localhost:9099/emails
#    Backend chạy trong Docker thì thay localhost bằng host.docker.internal (hoặc IP máy chạy test).
#    Suất chiếu của test được tạo +1 giờ/+3 giờ nên cần CancelDeadlineHours = 2 (mặc định) và
#    CancelRefundPercent > 0 trong Cài đặt rạp của DB E2E.
# E2E_MOCK_GATEWAY_PORT=9099
