@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageAlign left
skinparam maxMessageSize 300
skinparam ParticipantPadding 10
skinparam dpi 150
autonumber

actor "Nhân viên / Quản trị viên" as NV
participant "AdminCounterController" as C
participant "CounterBookingService" as S
participant "IAppDbContext" as DB
participant "IRealtimeNotifier" as N

== Pha 1: Giữ ghế tại quầy (Counter Hold) ==
NV -> C : POST /api/v1/admin/bookings/counter-hold (StaffOnly)
alt Tài khoản không có hồ sơ nhân viên
  C --> NV : 422 BusinessRuleException (Rule_NoEmployeeProfileForCounterBooking)
end
C -> S : CounterHoldSeatsAsync(employeeId, employeeUserId, request)
S -> S : EnsureWithinBookingLimitsAsync(seats, combos)
S -> DB : LoadSeatSlotsAsync(showtimeId)
S -> S : ValidateSelection (chế độ SeatGapRuleMode.Off — không áp luật ghế lẻ)
alt Chọn khách thành viên (có UserId)
  S -> DB : Tra cứu Users (kiểm tra IsActive, vai trò Customer)
else Khách vãng lai (không có UserId)
  S -> S : Nhận CustomerName, CustomerPhone nhập tay
end
S -> S : CreateHoldBookingAsync (channel = Counter, holder = nhân viên)
note over S : Kiểm tra suất Scheduled, chưa chiếu;\nChặn nhân viên có >1 đơn chờ trên cùng suất
S -> DB : Giữ ghế nguyên tử (ShowtimeSeats: Status = Held, HeldUntil, HeldByBookingId)
S -> S : Tính TotalAmount, DiscountAmount (tính trên vé theo điểm), FinalAmount
S -> DB : Thêm Booking (Pending, FinalAmount, ExpiresAt = now + 15 phút)
S -> DB : SaveChangesAsync()
S -> N : NotifySeatHeldAsync (phát realtime ghế đang giữ)
S --> C : CounterHoldResponse (bookingId, bookingCode, Pending, amounts, expiresAt)
C --> NV : 201 Created { CounterHoldResponse }

== Pha 2: Thanh toán tiền mặt & Xác nhận phát vé (Counter Checkout) ==
NV -> C : POST /api/v1/admin/bookings/{bookingId}/counter-checkout (AmountReceived)
C -> S : CounterCheckoutAsync(bookingId, request)
S -> DB : Bookings.FirstOrDefaultAsync(bookingId)
alt Đơn không tồn tại hoặc không thuộc kênh Counter
  S --> NV : 404 / 422 Exception (Rule_CounterPaymentOnlyForCounterBooking)
else Đơn không Pending hoặc đã quá hạn ExpiresAt
  S --> NV : 422 BusinessRuleException (Rule_BookingNotPendingOrHoldExpired)
else AmountReceived < FinalAmount
  S --> NV : 422 BusinessRuleException (Rule_AmountReceivedInsufficient)
end
S -> S : change = AmountReceived - FinalAmount
S -> DB : BeginTransactionAsync()
S -> DB : Payments.Add (Cash, Success, Amount = FinalAmount, AmountReceived, ChangeGiven, PaidAt)
S -> DB : SaveChangesAsync()
S -> S : ConfirmBookingAndGenerateTicketsAsync(bookingId)
note over S : Booking: Status = Confirmed;\nShowtimeSeats: Status = Booked;\nSinh mã vé & mã QR từng ghế;\nGhi sổ điểm LoyaltyPointEntry (nếu có UserId)
S -> DB : CommitAsync()
S -> N : NotifySeatBookedAsync (phát realtime ghế đã bán)
S --> C : CounterCheckoutResponse (bookingId, "Confirmed", change)
C --> NV : 200 OK { CounterCheckoutResponse }
@enduml
